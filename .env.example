BASE_API_TOKEN=
TEST_MODE=false
DRY_RUN=true
# Finestra mobile e soglie prudenziali interne, non quote ufficiali Base.com.
BASE_API_WINDOW_MS=60000
BASE_API_SAFE_LIMIT=90
# Deve essere inferiore alla soglia di sicurezza; sotto questa soglia nessuna attesa preventiva.
BASE_API_SOFT_LIMIT=80
# Tentativi totali per lettura, incluso il primo (1-10).
BASE_API_READ_ATTEMPTS=3
BASE_API_RETRY_DELAY_MS=1000
# Pausa condivisa su 429 / ERROR_BLOCKED_TOKEN; Retry-After puo prolungarla.
BASE_API_RATE_LIMIT_DELAY_MS=60000
